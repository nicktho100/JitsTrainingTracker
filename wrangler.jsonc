{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mat-time-tracker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mat-time-db",
      "database_id": "93817706-0ebe-406f-9db1-53fb7f0006dd",
      "migrations_dir": "drizzle"
    }
  ]
}
